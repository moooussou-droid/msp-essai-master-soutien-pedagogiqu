{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-local-llm-worker.mjs && node scripts/postbuild.mjs",
    "build:lowmem": "node scripts/esbuild-prod.mjs && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "preview:static": "node scripts/preview-server.mjs --root deploy --host 0.0.0.0 --port 8000",
    "deploy:check": "node scripts/deploy-check.mjs",
    "deploy:verify": "node scripts/deploy-verify.mjs",
    "ai:access": "node scripts/manage-ai-access.mjs",
    "test:ai-gateway": "node --test tests/aiGateway.test.mjs",
    "test:prep-fiche-cloud": "node --test tests/prepFicheCloudSync.test.mjs",
    "test:ai-generation-policy": "node --test tests/aiGenerationPolicy.test.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@tesseract.js-data/fra": "^1.0.0",
    "@types/exceljs": "^0.5.3",
    "clsx": "2.1.1",
    "exceljs": "^4.4.0",
    "idb": "^8.0.3",
    "jspdf": "^3.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.23.0",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^5.6.205",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^6.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "^0.27.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
