{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:lowmem",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/ai/chat.js": { "maxDuration": 150 },
    "api/ai/prep-fiches.js": { "maxDuration": 60 },
    "api/ai/session.js": { "maxDuration": 30 },
    "api/ai/providers.js": { "maxDuration": 10 }
  },
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/assets/ort-wasm-simd-threaded.asyncify.wasm.gz",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Content-Encoding", "value": "gzip" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
