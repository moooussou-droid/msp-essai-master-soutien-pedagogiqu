# Secrets et paramètres Vercel — configurez-les dans Settings > Environment Variables.
# Ne préfixez JAMAIS les secrets par VITE_ ou NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Clé recommandée : Settings > API Keys > Secret key (sb_secret_...). Serveur uniquement.
SUPABASE_SECRET_KEY=
# Compatibilité avec l’ancienne clé JWT service_role si nécessaire :
SUPABASE_SERVICE_ROLE_KEY=
MSP_AI_SESSION_SECRET=

# Paramètre de build non secret : évite un téléchargement CUDA Linux inutile pendant npm install.
ONNXRUNTIME_NODE_INSTALL=skip

# Fournisseurs; ne renseignez que ceux que vous avez activés et financés.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODELS=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MODELS=

MISTRAL_API_KEY=
MISTRAL_MODEL=
MISTRAL_MODELS=

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=
PERPLEXITY_MODELS=

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODELS=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_MODELS=

# Optionnel — Azure OpenAI; ce n'est pas l'application grand public Copilot.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_DEPLOYMENTS=
AZURE_OPENAI_API_VERSION=2024-10-21

# Limites de coût/abus; le quota par code est défini à sa création.
MSP_AI_PER_MINUTE_LIMIT=3
MSP_AI_GLOBAL_DAILY_LIMIT=500
MSP_AI_MAX_OUTPUT_TOKENS=3000
MSP_AI_ALLOWED_ORIGINS=
